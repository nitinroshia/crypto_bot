# Copy to .env (never commit .env). Names only; the owner fills the values locally.
# PostgreSQL (use DATABASE_URL, or the PG* variables):
DATABASE_URL=
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=
# Upstox: the read-only ANALYTICS token (valid one year) from the owner's Upstox Developer Apps page:
UPSTOX_ANALYTICS_TOKEN=
# Fallback only (the ordinary access token expires at 3:30 every morning):
UPSTOX_ACCESS_TOKEN=
